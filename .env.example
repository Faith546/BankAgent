# =============================================================================
# BankAgent — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como `.env` (ignorado en Git) y ajusta según tu equipo.
# IMPORTANTE: Nunca pongas API keys externas aquí ni uses https:// para Ollama.
# =============================================================================

# --- Servidor Ollama (HTTP plano, sin TLS) ---
# En local: http://localhost:11434
# En servidor remoto con GPU: http://<IP_DEL_SERVIDOR>:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Modelos Ollama ---
# Principal (9B recomendado; alternativa ligera en 8 GB VRAM: qwen2.5:7b-instruct-q4_K_M)
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Parámetros de Inferencia ---
# temperature=0.0 maximiza reproducibilidad en tool-calling y cifras
OLLAMA_TEMPERATURE=0.0
# reasoning=false (think: False) evita respuestas vacías en qwen3.5:9b
OLLAMA_REASONING=false
# Ventana de contexto: 8192 en laptop 8 GB VRAM | 16384 en servidor GPU 20 GB VRAM
OLLAMA_NUM_CTX=8192
# Opcionales (dejar vacíos para conservar defaults del modelo)
OLLAMA_TOP_K=
OLLAMA_TOP_P=

# --- Límites de Seguridad del Agente (Guardrail 2) ---
AGENT_MAX_TURNS=8

# --- Ruta opcional del CSV fuente ---
# Por defecto busca data/raw/base_cards_sintetica.csv (o *_mini.csv)
BANKAGENT_CSV_PATH=
